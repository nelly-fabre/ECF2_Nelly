{% extends 'base.html.twig' %}

{% block title %}Hello LogsController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
 <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Logs</h1>
        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">← Accueil</a>
    </div>

    <p class="text-muted">Liste des actions effectuées</p>

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Date</th>
                <th>Action</th>
                <th>Entity</th>
                <th>Entity ID</th>
                <th>Admin</th>
            </tr>
        </thead>
        <tbody>
            {% for log in logs %}
                <tr>
                    <td>{{ log.date }}</td>
                    <td>{{ log.action }}</td>
                    <td>{{ log.entity }}</td>
                    <td>{{ log.entityId }}</td>
                    <td>{{log.admin }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucune donnée disponible.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
