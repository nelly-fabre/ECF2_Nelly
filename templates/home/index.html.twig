{% extends 'base.html.twig' %}

{% block title %}Trombinoscope{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Trombinoscope</h1>
        {% if app.user %}
            <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary">Déconnexion ({{ app.user.userIdentifier }})</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-outline-primary">Connexion admin</a>
        {% endif %}
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        {% for student in students %}
            <div class="col">
                <a href="{{ path('app_student_show', {'id': student.id}) }}" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm">
                        {% if student.picture %}
                            <img src="{{ asset('uploads/students/' ~ student.picture) }}"
                                class="card-img-top"
                                style="height: 200px; object-fit: cover;"
                                alt="Photo de {{ student.firstName }} {{ student.familyName }}">
                        {% else %}
                            <div class="card-img-top d-flex align-items-center justify-content-center bg-secondary text-white"
                                style="height: 200px;">
                                Pas de photo
                            </div>
                        {% endif %}

                        <div class="card-body {% if student.unjustifiedAbsences >= 5 %}text-danger{% endif %}">
                            <h5 class="card-title">
                                {{ student.firstName }} {{ student.familyName }}
                            </h5>

                        
                        </div>
                    </div>
                </a>
            </div>
        {% else %}
            <p>Aucun stagiaire à afficher.</p>
        {% endfor %}
    </div>
</div>
{% if is_granted('ROLE_ADMIN') %}<a href="{{ path('app_student_new') }}" class="btn btn-primary mb-5">Create new</a>{%endif %}
{% endblock %}