{% extends 'base.html.twig' %}

{% block title %}Absence{% endblock %}

{% block body %}
    <h1>Absence</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Stagiaire</th>
                <td>{{ absence.student.firstName }} {{ absence.student.familyName }}</td>
            </tr>
            <tr>
                <th>Date de l'absence</th>
                <td>{{ absence.absenceDay ? absence.absenceDay|date('d-m-Y') : '' }}</td>
            </tr>
            <tr>
                <th>Justificatif</th>
                <td> {% if absence.absenceDocument %}
                    <a href="{{ asset('uploads/documents/' ~ absence.absenceDocument) }}" target="_blank">Voir le PDF</a>
                {% else %}
                    <span class="text-muted">Aucun justificatif</span>
                {% endif %}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_student_index') }}">Retour aux stagiaires</a>
    <a href="{{ path('app_absence_new', {'student': student.id}) }}" class="btn btn-success">Ajouter une absence</a>
    <a href="{{ path('app_absence_edit', {'id': student.id}) }}">Modifier</a>

    {{ include('absence/_delete_form.html.twig') }}
{% endblock %}
